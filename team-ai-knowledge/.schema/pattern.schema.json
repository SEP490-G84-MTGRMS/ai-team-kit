{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Pattern or Best Practice",
  "type": "object",
  "required": ["id", "title", "date", "author", "scope", "category"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PAT-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["architecture", "code-style", "testing", "security", "workflow"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changelog": {
      "type": "array",
      "description": "Audit log of modifications made via sua_tai_lieu",
      "items": {
        "type": "object",
        "required": ["date", "author", "reason", "impact"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    }
  }
}
