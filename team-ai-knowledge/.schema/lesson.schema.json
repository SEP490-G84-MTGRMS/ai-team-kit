{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lesson Learned",
  "type": "object",
  "required": ["id", "title", "date", "author", "scope", "severity", "resolution"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LL-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "description": "Unique ID, format: LL-2026-09-14-001"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": ["string", "null"],
      "description": "ID của session đã sinh ra lesson này"
    },
    "scope": {
      "type": "string",
      "enum": ["backend", "frontend", "infra", "devops", "database", "security", "performance", "qa", "testing", "cross-cutting"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "resolution": {
      "type": "string",
      "enum": ["resolved", "workaround", "investigating", "wont-fix"]
    },
    "related_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-\\d{4}$"
      }
    },
    "changelog": {
      "type": "array",
      "description": "Audit log of modifications made via sua_tai_lieu",
      "items": {
        "type": "object",
        "required": ["date", "author", "reason", "impact"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    }
  }
}
