{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Session Summary",
  "type": "object",
  "required": ["id", "date", "author", "project", "goals"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "epic": {
      "type": "string",
      "description": "Epic or feature name grouping this session"
    },
    "goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["completed", "in-progress", "blocked"]
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changelog": {
      "type": "array",
      "description": "Audit log of modifications made via sua_tai_lieu",
      "items": {
        "type": "object",
        "required": ["date", "author", "reason", "impact"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    }
  }
}
