skinparam ArrowFontColor #000000
skinparam ArrowFontSize 11

skinparam SwimlaneBorderColor #000000
skinparam SwimlaneBorderThickness 1.5
skinparam SwimlaneTitleFontColor #000000
skinparam SwimlaneTitleFontSize 13
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneWidth 240

title FLOW 2 (TO-BE) — Digital Customer Credit Control at POS (FE-08 & FE-17)

|Customer|
|Cashier / POS Staff|
|MT-GRMS System|

|Customer|
start
:Bring selected items\nto checkout counter;

|Cashier / POS Staff|
:Scan product barcodes\non mPOS interface;

|MT-GRMS System|
:Calculate total amount\n& display bill summary;

|Customer|
:Receive bill summary;
if (Request to buy on credit\n(deferred payment)?) then (No - Pay Now)
  |Customer|
  :Pay via Cash\nor Dynamic VietQR;
  |Cashier / POS Staff|
  :Collect payment\n& complete order;
  |MT-GRMS System|
  :Generate Sales Receipt\nin Cashbook (FE-17);\nPost revenue to S2a-HKD;
else (Yes - Buy on Credit)
  |Cashier / POS Staff|
  :Select customer profile\nin MT-GRMS database;
  |MT-GRMS System|
  :Check credit profile (FE-08):\nVerify credit limit &\ncheck overdue debt;
  if (Credit status valid?\n(Within limit & No overdue)) then (No - Blocked)
    :Display red alert:\n"Credit limit exceeded\nor overdue debt exists";
    |Cashier / POS Staff|
    :Notify customer of rejection;\nDemand immediate payment;
    if (Customer agrees\nto pay now?) then (Yes)
      |Customer|
      :Pay via Cash or QR;
      |Cashier / POS Staff|
      :Collect payment;
      |MT-GRMS System|
      :Create Sales Receipt (FE-17);
    else (No)
      |Cashier / POS Staff|
      :Void pending cart;\nReturn items to shelf;
      stop
    endif
  else (Yes - Approved)
    |Cashier / POS Staff|
    :Confirm credit transaction\non mPOS screen;
    |MT-GRMS System|
    :Create AR debt record (FE-08);\nIncrease customer debt balance;\nSend Zalo/SMS debt alert;
    :Post revenue to S2a-HKD\nwith "Unpaid Credit" tag;
  endif
endif

|Cashier / POS Staff|
:Hand over goods with\nelectronic receipt;
stop
@enduml

