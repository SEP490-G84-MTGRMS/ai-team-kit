skinparam SwimlaneTitleFontColor #000000
skinparam SwimlaneTitleFontSize 13
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneWidth 240

title FLOW 1 (TO-BE) — Standardized Service Expense & Cashbook Voucher (FE-07 & FE-17)

|Service Provider / Landlord|
|Branch Staff / Manager|
|MT-GRMS System|
|Store Owner|

|Service Provider / Landlord|
start
:Deliver utility / rent\ninvoice or digital bill;

|Branch Staff / Manager|
:Log in MT-GRMS (FE-07);\nCapture photo of bill\n& input expense details;

|MT-GRMS System|
:Verify expense policy;\nCheck branch auto-limit\n(e.g., threshold 500k VND);

if (Expense amount >\nbranch auto-limit?) then (Yes - Requires Approval)
  :Flag "Pending Approval";\nPush alert to Store Owner;
  |Store Owner|
  :Review bill photo\n& expense justification;
  if (Approve expense request?) then (No - Rejected)
    :Reject expense voucher\nwith reason comment;
    |Branch Staff / Manager|
    :Receive rejection notice;\nCancel payment / revise;
    stop
  else (Yes - Approved)
    :Confirm approval on mobile;
  endif
else (No - Under Limit)
  |MT-GRMS System|
  :Auto-approve expense under\nbranch daily allowance;
endif

|MT-GRMS System|
:Unlock payment execution;\nPrompt fund source selection;

|Branch Staff / Manager|
if (Disbursement Fund Source?) then (Branch Cash Till)
  :Withdraw physical cash\nfrom till & pay provider;
  |MT-GRMS System|
  :Create Cash Disbursement\nVoucher in FE-17;\nDeduct branch till balance;
else (Digital Bank Account)
  |Store Owner|
  :Execute payment via\nconnected digital banking;
  |MT-GRMS System|
  :Create Bank Disbursement\nVoucher in FE-17;\nDeduct central bank ledger;
endif

|MT-GRMS System|
:Post entry to Statutory\nExpense Ledger S2c-HKD;\nUpdate Branch P&L (FE-10);

|Branch Staff / Manager|
:File voucher & complete;
stop
@enduml

