'          FE-10 (P&L & Financial Reports), FE-17 (Cashbook), FE-19 (Tax Reports)
' Developer: Nguyen Truong An
' Standard: UML 2.5 Activity Diagram with Multi-Branch Decision & Merge Diamonds
' ==============================================================================

' ==============================================================================
' FLOW 1 (AS-IS): SERVICE EXPENSE & PETTY CASH DISBURSEMENT (THỦ CÔNG)
' ==============================================================================
@startuml AS_IS_Flow1_ServiceExpense_CashDisbursement

skinparam defaultTextAlignment center
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam ActivityBackgroundColor #A9D8FF
skinparam ActivityBorderColor #000000
skinparam ActivityBorderThickness 1.2
skinparam ActivityFontColor #000000
skinparam ActivityFontSize 12

skinparam DiamondBackgroundColor #A9D8FF
skinparam DiamondBorderColor #000000
skinparam DiamondBorderThickness 1.2
skinparam DiamondFontColor #000000
skinparam DiamondFontSize 11

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 11

skinparam SwimlaneBorderColor #000000
skinparam SwimlaneBorderThickness 1.5
skinparam SwimlaneTitleFontColor #000000
skinparam SwimlaneTitleFontSize 13
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneWidth 240

title FLOW 1 (AS-IS) — Manual Service Expense Payment & Cash Outflow

|Service Provider / Landlord|
|Branch Cashier / Staff|
|Store Owner|

|Service Provider / Landlord|
start
:Bring utility, rent,\nor internet bill to\nstore & request payment;

|Branch Cashier / Staff|
if (Store Owner\npresent at store?) then (Yes)
  |Store Owner|
  :Take out personal\nwallet or personal\nbanking app to pay;
  :Stuff paper receipt\ninto drawer corner\nwithout ledger record;
else (No)
  |Branch Cashier / Staff|
  :Contact Store Owner\nvia phone to request\npayment authorization;
  if (Owner approves\nimmediate payout?) then (No / Cannot reach)
    :Tell provider to\nreturn later;\nRisk utility cut-off;
  else (Yes)
    :Take cash directly\nfrom cash drawer\nto pay provider;
    :Tuck paper bill\nunder cashier counter;\nForget shift note;
    |Store Owner|
    :Periodically check\ntill; discover cash\nshortage vs sales;
    if (Can locate paper\nbill under counter?) then (Yes)
      :Manually reconcile\nshortage; no expense\nledger entry kept;
    else (No)
      :Conflict & dispute\nwith cashier over\nsuspected theft;
    endif
  endif
endif

|Store Owner|
stop
@enduml

' ==============================================================================
' FLOW 1 (TO-BE): AUTOMATED EXPENSE WORKFLOW & CASHBOOK POSTING (MT-GRMS)
' Clean layout with unified approval and fund-source routing
' ==============================================================================
