skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 11

skinparam SwimlaneBorderColor #000000
skinparam SwimlaneBorderThickness 1.5
skinparam SwimlaneTitleFontColor #000000
skinparam SwimlaneTitleFontSize 13
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneWidth 240

title FLOW 2 (AS-IS) — Customer Purchases & Manual Debt Ledger (Reference Standard)

|Customer|
|Store Owner / Employee|

|Customer|
start
:Bring selected products\nto checkout counter;

|Store Owner / Employee|
repeat
  :Inspect item & calculate\nprice manually (from\nmemory / calculator);
repeat while (More products?) is (Yes) not (No)

:Calculate final total\npayable amount;

|Customer|
:Receive verbal notification\nof total payable amount;

if (Customer requests to buy\non credit (deferred payment)?) then (No - Immediate payment)
  |Store Owner / Employee|
  :Receive cash payment\n& place into till;
else (Yes)
  |Customer|
  :Ask to buy\non credit;
  |Store Owner / Employee|
  if (Agree to\nextend credit?) then (Yes)
    :Record debt into physical\nledger (Customer Name,\ndate, amount);
  else (No)
    :Decline credit purchase;\nRequire immediate payment;
    if (Customer agrees\nto pay now?) then (Yes)
      :Collect payment\n& hand over goods;
    else (No)
      :Cancel sale &\nreturn items to shelf;
    endif
  endif
endif

|Store Owner / Employee|
stop
@enduml

' ==============================================================================
' FLOW 2 (TO-BE): DIGITAL CUSTOMER CREDIT CONTROL AT POS (FE-08 & FE-17)
' Direct 1-to-1 counterpart of AS-IS Flow 2 — Clean, Vertical, Zero Overlap
