# ==============================================================================
# CẤU HÌNH GOOGLE APPS SCRIPT CHO TEST REPORT GATEWAY (REPORT 5.1 -> 5.5)
# ==============================================================================

# URL Web App nhận được sau khi Deploy Google Apps Script (Deploy > New Deployment > Web app)
# Định dạng: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/AKfycbyk9ES-9OFgNxZFkflnLBGjKOUh9TLVIJMjyh2nRYw6ppmw--vkCLSH2-F0zWcLA-PdWg/exec

# Mã khóa bảo mật API (Phải khớp với CONFIG.API_KEY trong file Code.gs)
GOOGLE_SHEET_API_KEY=MT_GRMS_TEST_SECRET_2026

# Tên người thực hiện test mặc định khi ghi lên Sheet (ví dụ: Sơn, Đức, Tâm, An, Nhật...)
GOOGLE_SHEET_DEFAULT_TESTER=AI-Agent

# Đường dẫn file Master Test Matrix trên máy cục bộ
LOCAL_TEST_MATRIX_PATH=D:\Sourse_code_Do_An\Bao_Cao\MT_GRMS_Test_Matrix_and_Cases.xlsx
